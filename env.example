# ── Database ──────────────────────────────────────────────────────────────────
# Full postgres DSN or URL (required)
DB_URL=postgres://postgres:secret@localhost:5432/crypto?sslmode=disable

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
S3_BUCKET=

# ── Collector ─────────────────────────────────────────────────────────────────
# Source: "binance" (default) or "coingecko"
PRICE_SOURCE=binance

# Comma-separated coin symbols. All must exist in internal/collector/coins.go.
# Supported: BTC ETH SOL BNB XRP ADA DOGE AVAX DOT LINK MATIC UNI ATOM LTC TRX
COINS=BTC,ETH,SOL,BNB,XRP,ADA,DOGE

# Collection interval in seconds (default: 60)
COLLECT_INTERVAL_SEC=60

# ── HTTP ──────────────────────────────────────────────────────────────────────
HTTP_PORT=8080

# Set to "debug" for verbose gin logs in development
GIN_MODE=release
